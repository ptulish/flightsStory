PORT=8787
FRONTEND_ORIGIN=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
APP_JWT_SECRET=replace-with-long-random-secret

# Google OAuth credentials for /api/auth/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. Defaults to http://localhost:8787/api/auth/google/callback
# GOOGLE_REDIRECT_URI=

# Infrastructure
DATABASE_URL=postgres://postgres:postgres@localhost:5432/skyhistory
REDIS_URL=redis://localhost:6379

# Queue worker
INLINE_WORKER=true

# LLM parser (optional but recommended)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Scanning limits
GMAIL_MAX_MESSAGES=150
ICLOUD_MAX_MESSAGES=150
IMAP_DEFAULT_HOST=imap.mail.me.com
IMAP_DEFAULT_PORT=993
IMAP_DEFAULT_TLS=true
